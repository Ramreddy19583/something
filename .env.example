# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/opportunity_ai"

# Application Security
JWT_SECRET="replace-with-a-random-32-char-string-in-production"
COOKIE_NAME="oppai_session"
NODE_ENV="production"

# AI Service Configuration
# AI_PROVIDER: "rule-based" (grounded, deterministic engine, requires no API key),
# "openai", "gemini", "anthropic"
AI_PROVIDER="rule-based"
AI_MODEL=""
AI_API_KEY=""

# Application Host
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
